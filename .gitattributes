# Normaliza automáticamente los archivos de texto entre sistemas operativos.
* text=auto
# El código y las configuraciones usan saltos de línea LF, igual que Linux.
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
Dockerfile text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
