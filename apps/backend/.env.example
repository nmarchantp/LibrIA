# setup.cmd genera DATABASE_URL, JWT_SECRET y LIBRIA_DEMO_PASSWORD para cada equipo.
APP_NAME=LibrIA API
APP_ENV=development
API_PREFIX=/api
DATABASE_URL=
FRONTEND_ORIGINS=http://localhost:5173
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Opcional: credenciales propias para Google OAuth y Google Books.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
GOOGLE_BOOKS_API_KEY=
GOOGLE_OAUTH_SCOPE=https://www.googleapis.com/auth/books
LIBRIA_DEMO_PASSWORD=
