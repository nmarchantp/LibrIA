# setup.cmd genera DATABASE_URL, JWT_SECRET y LIBRIA_DEMO_ADMIN_PASSWORD para cada equipo.
APP_NAME=LibrIA API
APP_ENV=development
API_PREFIX=/api
# true: página de bienvenida y registro sin sesión; false: acceso habitual. Reiniciar la API.
MAINTENANCE_MODE=false
DATABASE_URL=
FRONTEND_ORIGINS=http://localhost:5173
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
# La inactividad se renueva sólo con actividad explícita. El máximo absoluto
# obliga a volver a autenticarse aunque haya actividad continua.
SESSION_INACTIVITY_HOURS=24
SESSION_ABSOLUTE_HOURS=168
SESSION_ACTIVITY_WRITE_INTERVAL_SECONDS=300
SESSION_REFRESH_COOKIE_NAME=libria_refresh
# Vacío selecciona false en desarrollo y pruebas, y true en otros entornos.
# SESSION_COOKIE_SECURE=true

# Opcional: credenciales propias para Google OAuth y Google Books.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
GOOGLE_BOOKS_API_KEY=
# Opcional: contacto del responsable para identificar las consultas a Open Library.
OPEN_LIBRARY_CONTACT=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
# Si queda vacío, el remitente usa SMTP_USERNAME.
SMTP_FROM=
# El inicio de sesión usa siempre los permisos openid email profile; no solicita acceso a Google Books.
# Claves opcionales por cuenta. Vacías usan LIBRIA_DEMO_ADMIN_PASSWORD.
LIBRIA_DEMO_ADMIN_PASSWORD=
LIBRIA_DEMO_LECTOR_PASSWORD=
LIBRIA_DEMO_INFLUENCER_PASSWORD=
LIBRIA_DEMO_AUTOR_PASSWORD=
LIBRIA_DEMO_LIBRERIA_PASSWORD=
LIBRIA_DEMO_EDITORIAL_PASSWORD=
ANALYTICS_SCHEDULER_ENABLED=true
PROJECTION_SCHEDULER_ENABLED=true
# El proceso de trabajo se ejecuta por separado. No activar hasta confirmar
# servicio pagado, revisión legal y una clave almacenada fuera del repositorio.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
AI_TIMEOUT_SECONDS=180
RECOMMENDATION_PROMPT_VERSION=recommendations-v5-es
READING_ANALYSIS_PROMPT_VERSION=reading-event-v3-es
READING_ANALYSIS_DELAY_MINUTES=30
GEMINI_WORKER_ENABLED=false
GEMINI_PAID_SERVICE_CONFIRMED=false
# Exclusivo para pruebas reales con datos ficticios en los entornos development (desarrollo) y test (pruebas).
# Nunca activar fuera de esos entornos ni declarar una cuenta pagada.
GEMINI_FREE_TEST_MODE=false
AI_MAX_CONCURRENT_REQUESTS=2
AI_REQUESTS_PER_MINUTE=10
AI_JOB_MAX_ATTEMPTS=3
# Debe superar AI_TIMEOUT_SECONDS por al menos 30 segundos.
AI_JOB_LEASE_SECONDS=600
AI_WORKER_POLL_SECONDS=2
AI_RETRY_BASE_SECONDS=5
AI_CONTEXT_TOKEN_BUDGET=12000
AI_CHUNK_TOKEN_BUDGET=6000
AI_OUTPUT_TOKEN_BUDGET=2048
AI_JOB_TOKEN_BUDGET=100000
AI_MAX_CALLS_PER_JOB=24
AI_RECOMMENDATION_CANDIDATE_LIMIT=200
# Tarifa estándar de pago verificada para gemini-3.5-flash-lite el 2026-10-27.
# Revisar la página oficial antes de cambiar GEMINI_MODEL o activar producción.
AI_INPUT_COST_PER_MILLION_USD=0.30
AI_OUTPUT_COST_PER_MILLION_USD=2.50
AI_MONTHLY_BUDGET_USD=10.00
AI_PRICING_MODEL=gemini-3.5-flash-lite
# Cuota diaria de la aplicación, no detectada automáticamente del proveedor.
AI_FREE_DAILY_TOKEN_POOL=0
# Fase 5: los componentes que usan el catálogo canónico requieren descubrimiento y la migración 0058. Despliegue no autorizado.
CATALOG_CANONICAL_ENABLED=false
# Fase 4: activar solo con descubrimiento habilitado y la migración 0057 aplicada. Mantener en false.
CATALOG_EDITIONLESS_ENABLED=false
# true permite agrupar libros y revertir agrupaciones. Requiere APP_ENV=development o test, CATALOG_CANONICAL_ENABLED=true y CATALOG_ADMIN_PREVIEW_ENABLED=true.
CATALOG_ADMIN_MERGE_ENABLED=false
# true muestra Gestionar libros a administradores y permite consultar el catálogo y comparar posibles duplicados.
CATALOG_ADMIN_PREVIEW_ENABLED=false
# Fase 3: descubrimiento e incorporación vinculados. Mantener en false hasta aprobar el despliegue.
# true habilita el descubrimiento y la incorporación de libros. Junto con CATALOG_ADMIN_PREVIEW_ENABLED=true, permite crear y editar fichas y ediciones.
CATALOG_DISCOVERY_ENABLED=false
CATALOG_LOCK_TIMEOUT_MS=2000
CATALOG_STATEMENT_TIMEOUT_MS=10000
CATALOG_WRITE_ATTEMPTS=3
CATALOG_PROVIDER_TIMEOUT_SECONDS=45
