# setup.cmd genera DATABASE_URL, JWT_SECRET y LIBRIA_DEMO_PASSWORD para cada equipo.
APP_NAME=LibrIA API
APP_ENV=development
API_PREFIX=/api
DATABASE_URL=
FRONTEND_ORIGINS=http://localhost:5173
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Opcional: credenciales propias para Google OAuth y Google Books.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
GOOGLE_BOOKS_API_KEY=
# Opcional: contacto del responsable para identificar las consultas a Open Library.
OPEN_LIBRARY_CONTACT=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
# Si queda vacío, el remitente usa SMTP_USERNAME.
SMTP_FROM=
# El login usa siempre openid email profile; no solicita acceso a Google Books.
LIBRIA_DEMO_PASSWORD=
ANALYTICS_SCHEDULER_ENABLED=true
# Interpretación local de indicadores con Ollama; no requiere clave.
OLLAMA_BASE_URL=http://127.0.0.1:11434
AI_MODEL=qwen3:1.7b
AI_TIMEOUT_SECONDS=180
# false permite desplegar el worker aparte: python -m scripts.run_ai_worker
AI_WORKER_ENABLED=true
